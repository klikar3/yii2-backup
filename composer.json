{
    "name": "klikar3/yii2-backup",
    "description": "Database Backup and Restore functionality",
    "type": "yii2-extension",
    "keywords": ["yii2","Database", "Backup","Restore"],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Karl Klingler",
            "email": "klikar3@web.de"

        }
    ],
    "require": {
        "yidas/yii2-bower-asset": "*",
        "yiisoft/yii2": ">=2.0.38",
        "ifsnop/mysqldump-php": "*"
    },
    "autoload": {
        "psr-4": {
            "klikar3\\modules\\backup\\": ""
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
